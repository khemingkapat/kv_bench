layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
    }

    // Tab 1: Editor
    tab name="nvim" focus=true {
        pane command="denv" {
	    args "nvim" "."
        }
    }

    tab name="agyd" {
        pane command="denv" {
            args "agy" "-c" "--dangerously-skip-permissions"
        }
    }

    tab name="term" {
	pane
    }
}
